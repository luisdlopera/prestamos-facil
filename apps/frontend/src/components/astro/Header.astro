---
const currentPath = Astro.url.pathname;
const pathToTitle: Record<string, string> = {
  "/dashboard": "Dashboard",
  "/customers": "Gestión de Clientes",
  "/register-customer": "Registrar Nuevo Cliente",
  "/loan-applications": "Solicitudes de Préstamo",
  "/my-loan-applications": "Mis Solicitudes",
  "/new-loan-application": "Nueva Solicitud de Préstamo",
  "/loans": "Préstamos Activos",
  "/my-loans": "Mis Préstamos",
  "/reports": "Reportes Financieros",
  "/profile": "Mi Perfil",
};
const pageTitle = pathToTitle[currentPath] || "Préstamos Fácil";
---

<header class="header">
  <div class="header-content">
    <div class="header-breadcrumb">
      <span class="app-brand-badge">Sistema Financiero</span>
      <span class="breadcrumb-separator">/</span>
      <h1 class="page-title">{pageTitle}</h1>
    </div>
    <div class="header-actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #e2e8f0;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .header-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .app-brand-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2563eb;
    background-color: #eff6ff;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid #dbeafe;
  }

  .breadcrumb-separator {
    color: #94a3b8;
    font-size: 0.875rem;
  }

  .page-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .header {
      padding: 0 1rem;
    }
    .app-brand-badge {
      display: none;
    }
    .breadcrumb-separator {
      display: none;
    }
    .page-title {
      font-size: 1rem;
    }
  }
</style>
