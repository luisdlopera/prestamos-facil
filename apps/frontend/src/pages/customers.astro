---
import { UserPlus } from "lucide-react";
import AppLayout from "../layouts/AppLayout.astro";
import { CustomersTable } from "../features/customers";
---

<AppLayout>
  <section>
    <div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-foreground">Clientes</h1>
        <p class="text-sm text-muted">Gestión de clientes registrados</p>
      </div>
      <a
        href="/register-customer"
        class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-medium text-white hover:bg-blue-700"
      >
        <UserPlus size={16} />
        Nuevo Cliente
      </a>
    </div>
    <CustomersTable client:load />
  </section>
</AppLayout>
