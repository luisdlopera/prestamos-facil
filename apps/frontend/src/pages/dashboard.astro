---
import AppLayout from "../layouts/AppLayout.astro";
import { DashboardStats } from "../features/dashboard/ui/DashboardStats";
import { DashboardChart } from "../features/dashboard/ui/DashboardChart";
import { DashboardRecentApplications } from "../features/dashboard/ui/DashboardRecentApplications";
---

<AppLayout>
  <div class="space-y-6">
    <DashboardStats client:load />

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <DashboardChart client:load />
      <DashboardRecentApplications client:load />
    </div>
  </div>
</AppLayout>
