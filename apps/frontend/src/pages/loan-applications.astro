---
import AppLayout from "../layouts/AppLayout.astro";
import { LoanApplicationsPage } from "../features/loan-applications";

const search = Astro.url.searchParams.get("search") ?? undefined;
---

<AppLayout>
  <section>
    <div class="mb-6 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-foreground">Solicitudes</h1>
        <p class="text-sm text-muted">Administración de solicitudes de préstamo</p>
      </div>
    </div>

    <LoanApplicationsPage client:load defaultSearch={search} />
  </section>
</AppLayout>
