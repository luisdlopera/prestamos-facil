# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prestamos_facil
DB_USERNAME=prestamos
DB_PASSWORD=replace-with-random-secret

# --- Backend ---
HTTP_PORT=4010
HTTP_PORT_FALLBACK=4011
SPRING_PROFILES_ACTIVE=dev

# --- Auth / JWT ---
JWT_SECRET=generate-a-256-bit-base64-key-at-least-32-chars

# --- Email (Mailpit by default for dev) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAILPIT_SMTP_PORT=4025
MAILPIT_UI_PORT=4050

# --- Frontend ---
FRONTEND_PORT=4000
FRONTEND_PORT_FALLBACK=4001
PUBLIC_API_BASE_URL=http://localhost:4010/api/v1
FRONTEND_ORIGIN=http://localhost:4000
